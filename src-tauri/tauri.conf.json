{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "City Labs",
  "version": "../package.json",
  "identifier": "io.github.vicimpa.citylabs",
  "build": {
    "beforeDevCommand": "npm run build:app && npm run dev:desktop",
    "devUrl": "http://localhost:5199/editor/?host=app",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "City Labs",
        "width": 1600,
        "height": 1000,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/mcp.cjs",
      "resources/node-LICENSE.txt"
    ],
    "externalBin": [
      "binaries/city-labs-node"
    ],
    "fileAssociations": [
      {
        "ext": [
          "vspb"
        ],
        "name": "City Labs world",
        "role": "Editor",
        "mimeType": "application/x-vspb",
        "exportedType": {
          "identifier": "io.github.vicimpa.citylabs.world",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
